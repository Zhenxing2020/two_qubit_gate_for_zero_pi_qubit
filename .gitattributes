# Binary files - always use remote version during merge
*.png binary merge=ours
*.jpg binary merge=ours
*.jpeg binary merge=ours
*.gif binary merge=ours
*.bmp binary merge=ours
*.tiff binary merge=ours
*.pdf binary merge=ours
*.eps binary merge=ours
*.svg binary merge=ours

# Data files - always use remote version during merge
*.npz binary merge=ours
*.npy binary merge=ours
*.h5 binary merge=ours
*.hdf5 binary merge=ours
*.mat binary merge=ours
*.pkl binary merge=ours
*.pickle binary merge=ours

# Other binary files
*.zip binary merge=ours
*.tar.gz binary merge=ours
*.bson binary merge=ours

# Jupyter notebooks - always use remote version during merge
*.ipynb merge=theirs

# Large numeric data should be stored via Git LFS.
# These rules are ready; run `git lfs install` in this repo first.
data/**/*.npz filter=lfs diff=lfs merge=lfs -text
data/**/*.npy filter=lfs diff=lfs merge=lfs -text
cz/data/**/*.npz filter=lfs diff=lfs merge=lfs -text
cz/data/**/*.npy filter=lfs diff=lfs merge=lfs -text
cnot/data/**/*.npz filter=lfs diff=lfs merge=lfs -text
cnot/data/**/*.npy filter=lfs diff=lfs merge=lfs -text
xgate/data/**/*.npz filter=lfs diff=lfs merge=lfs -text
xgate/data/**/*.npy filter=lfs diff=lfs merge=lfs -text